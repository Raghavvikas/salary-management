{
  "name": "salary-management",
  "private": true,
  "version": "0.1.0",
  "description": "Salary management software for ACME's HR team",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "dev": "npm run dev --workspace=server & npm run dev --workspace=web",
    "test": "npm run test --workspace=server"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true,
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true,
    "esbuild@0.25.12": true
  }
}
